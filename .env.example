# ============================================================================
# RRB OFFICIAL NOTICE MONITOR — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Never commit real tokens or secrets to Git. Copy to .env for local runs.

# --- Telegram Bot API Configuration ---
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_OR_CHANNEL_ID_HERE"

# --- GitHub Contents API Persistent State Store ---
GITHUB_TOKEN="YOUR_FINE_GRAINED_GITHUB_PAT_HERE"
GITHUB_OWNER="YOUR_GITHUB_USERNAME_OR_ORG"
GITHUB_REPO="rrb-notice-monitor-state"
GITHUB_BRANCH="main"
GITHUB_STATE_PATH="state/notices.json"

# --- Endpoint Authentication Secrets ---
CRON_AUTH_TOKEN="GENERATE_64_CHAR_HEX_CRON_SECRET_HERE"
ADMIN_AUTH_TOKEN="GENERATE_64_CHAR_HEX_ADMIN_SECRET_HERE"

# --- Scraper & Operational Tuning (Optional with sensible defaults) ---
SCRAPER_REQUEST_TIMEOUT_MS="6000"
SCRAPER_MAX_RETRIES="1"
SCRAPER_CONCURRENCY="6"
CRON_EXECUTION_BUDGET_MS="24000"
CRON_BATCH_SIZE="22"
OLDER_PUBLICATION_DATE_POLICY="quarantine"
MAX_NOTICE_AGE_DAYS="14"
MAX_NOTIFICATIONS_PER_RUN="10"
NOTICE_FILTER_KEYWORDS=""
RRB_PORTAL_MIRROR_URL=""
RRB_PORTAL_MIRROR_AUTH_TOKEN=""
STATE_RETENTION_DAYS="365"
LOCAL_FALLBACK_STATE_PATH=".local-state/notices.json"

# --- GitHub Actions Workflow (.github/workflows/monitor.yml) Optional Overrides ---
# In GitHub Actions direct_cli mode, GITHUB_TOKEN, GITHUB_REPOSITORY, and GITHUB_REF_NAME
# are provided automatically when permissions: contents: write is configured.
GH_STATE_TOKEN=""
MONITOR_API_URL=""

# --- AI Studio / Host Runtime Variables ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"


